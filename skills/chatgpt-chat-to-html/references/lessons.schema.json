{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat replay lesson annotations",
  "type": "object",
  "required": ["schemaVersion", "sourceHash", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": "string"},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "lessonTitle", "note", "compareTo", "choice"],
        "properties": {
          "id": {"type": "string", "pattern": "^step-[0-9]{3,}$"},
          "title": {"type": "string"},
          "lessonTitle": {"type": "string"},
          "note": {"type": "string"},
          "compareTo": {"type": ["string", "null"], "pattern": "^step-[0-9]{3,}$"},
          "choice": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false,
               "required": ["options", "selected"],
               "properties": {
                 "options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                 "selected": {"type": "integer", "minimum": 0}
               }}
            ]
          }
        }
      }
    }
  }
}
